{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.andredelgado/continente-mcp",
  "title": "Continente MCP",
  "description": "Unofficial Continente.pt shopping: search products, read favorites and orders, manage the cart.",
  "repository": {
    "url": "https://github.com/andredelgado/continente-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/andredelgado/continente-mcp#readme",
  "version": "0.11.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "continentept-mcp",
      "version": "0.11.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONTINENTE_EMAIL",
          "description": "Continente.pt account email. Needed for the cart, favorites and orders.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "CONTINENTE_PASSWORD",
          "description": "Continente.pt account password.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "CONTINENTE_CREDENTIALS_FILE",
          "description": "Path to a private credentials file instead of the two variables above.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/andredelgado/continente-mcp/releases/download/v0.11.0/continente-mcp.mcpb",
      "fileSha256": "e057cbb8974e145f371cc1941d1ea42d59396a115a8ed41006d71a4f5219ab6e",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
